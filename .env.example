# ============================================
# 站点状态监测（/status 页面）配置
# 环境变量命名与原作者 imsyy/site-status 保持一致
# 配置定义文件：
#   服务端（敏感）: server/utils/status.config.ts
#   客户端（公共）: status.config.ts（项目根目录）
# ============================================

# UptimeRobot Read-only API Key（必填，服务端使用）
# 获取地址：https://dashboard.uptimerobot.com/integrations
# 只需 Read-only API Key 即可，无需写权限
API_KEY=

# UptimeRobot API 地址（可选，服务端使用，默认官方地址）
# 如遇 CORS 问题可配置反向代理地址
API_URL=https://api.uptimerobot.com/v2/

# 服务端内存缓存有效期（可选，单位：毫秒，默认 60000 = 1分钟，本项目特有）
STATUS_CACHE_TTL=60000

# 状态监测统计天数（可选，客户端使用，默认 60，建议 30-90）
COUNT_DAYS=60

# 是否在状态卡片上显示站点跳转链接（可选，客户端使用，默认 true）
SHOW_LINK=true

# 前端自动刷新间隔（可选，客户端使用，单位：秒，默认 300 = 5分钟，本项目特有）
STATUS_REFRESH_INTERVAL=300
