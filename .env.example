# ============================================
# 站点状态监测（/status 页面）配置
# ============================================

# UptimeRobot Read-only API Key（必填）
# 获取地址：https://dashboard.uptimerobot.com/integrations
# 只需 Read-only API Key 即可，无需写权限
STATUS_API_KEY=

# UptimeRobot API 地址（可选，默认官方地址）
# 如遇 CORS 问题可配置反向代理地址
STATUS_API_URL=https://api.uptimerobot.com/v2/

# 状态监测统计天数（可选，默认 60，建议 30-90）
STATUS_COUNT_DAYS=60

# 是否在状态卡片上显示站点跳转链接（可选，默认 true）
STATUS_SHOW_LINK=true
